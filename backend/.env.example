# 去水印解析服务环境变量示例
# 复制为 .env（或在部署平台的环境变量里配置）后按需填写

# 服务端口（Docker 默认 8000）
PORT=8000

# —— 各平台登录 Cookie（可选；免登录解析失效/被风控时配置）——
# 格式均为浏览器 Cookie 字符串：k1=v1; k2=v2
# 获取方式：浏览器登录对应网站后，F12 → 网络 → 复制请求头里的 Cookie

# 抖音：页面被风控/弹验证码时用
COOKIE_DOUYIN=

# 快手：页面结构风控时用（一般不需要）
COOKIE_KUAISHOU=

# 小红书：必填，否则接口直接返回 needs_login
COOKIE_XIAOHONGSHU=

# 微博：部分视频需要登录时用
COOKIE_WEIBO=

# 微信视频号：服务端暂不支持，留作未来扩展位
# COOKIE_WECHAT=
