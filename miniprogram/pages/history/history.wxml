<view class="container">
  <view class="card" wx:if="{{list.length === 0}}">
    <view class="empty">暂无解析记录\n去首页解析一条视频试试吧</view>
  </view>

  <view
    class="card item"
    wx:for="{{list}}"
    wx:key="time"
    data-index="{{index}}"
    bindtap="onItemTap"
  >
    <image class="cover" src="{{item.cover}}" mode="aspectFill" wx:if="{{item.cover}}"></image>
    <view class="info">
      <text class="title">{{item.title || '未命名视频'}}</text>
      <text class="sub">{{item.platform_name || '未知平台'}} · {{item.timeText}}</text>
    </view>
    <text class="arrow">›</text>
  </view>

  <button class="btn-ghost danger" wx:if="{{list.length > 0}}" bindtap="onClear">
    清空历史记录
  </button>
</view>
