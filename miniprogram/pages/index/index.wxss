/* 首页样式 */
.url-input {
  width: 100%;
  min-height: 140rpx;
  background: #f5f6f8;
  border-radius: 14rpx;
  padding: 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.ph {
  color: #bbbbbb;
}

.preview {
  width: 100%;
  height: 420rpx;
  border-radius: 14rpx;
  background: #000000;
}

.meta {
  margin-top: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.meta-title {
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.5;
}

.meta-sub {
  font-size: 26rpx;
  color: #888888;
}

.btn-half {
  margin-top: 0;
}
