/* 设置页样式 */
.base-input {
  width: 100%;
  background: #f5f6f8;
  border-radius: 14rpx;
  padding: 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.ph {
  color: #bbbbbb;
}

.btn-half {
  margin-top: 0;
}

.platforms {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.tag {
  background: #eef6fd;
  color: #1296db;
  font-size: 26rpx;
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
}

.loading-text {
  color: #999999;
  font-size: 26rpx;
}

.doc {
  font-size: 28rpx;
  line-height: 2;
  color: #555555;
  white-space: pre-wrap;
}

.doc.dim {
  color: #999999;
  font-size: 26rpx;
}
